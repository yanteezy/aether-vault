{
  "name": "aether-prototype",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "smoke": "npm run build && node scripts/smoke.mjs && node scripts/canvas-smoke.mjs",
    "build:prod": "tsc -p tsconfig.json && node scripts/build.mjs --prod",
    "dist": "npm run build:prod && electron-builder --win --publish never"
  },
  "build": {
    "appId": "app.aether.prototype",
    "productName": "Aether",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "index.html",
      "package.json",
      "!node_modules/**"
    ],
    "asarUnpack": [
      "dist/mcp/**",
      "dist/claude/**",
      "dist/main/galaxyWorker.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Aether-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yanteezy",
        "repo": "aether-vault"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Aether-${version}-mac.${ext}",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.10",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.0",
    "@fontsource/inter": "^5.3.0",
    "@lezer/common": "^1.5.7",
    "@lezer/highlight": "^1.2.5",
    "dompurify": "^3.5.0",
    "electron-updater": "^6.8.11",
    "lucide": "^1.80.0",
    "marked": "^18.3.0",
    "moment": "^2.31.0",
    "yaml": "^2.9.1"
  }
}
